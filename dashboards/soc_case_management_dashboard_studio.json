{
  "title": "SOC Case Management - ServiceNow Demo",
  "description": "Daily SOC case-management dashboard for synthetic ServiceNow incidents ingested into Splunk ES demo indexes.",
  "inputs": {
    "input_global_time": {
      "type": "input.timerange",
      "title": "Time Range",
      "options": {
        "defaultValue": "-7d@d,now",
        "token": "global_time"
      }
    }
  },
  "dataSources": {
    "ds_kpi_open_cases": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident state!=\"Closed\"\n| stats count as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_kpi_notables": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident u_splunk_notable_event_id=*\n| stats count as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_kpi_critical": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident priority IN (\"1 - Critical\",\"2 - High\") state!=\"Closed\"\n| stats count as value",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_kpi_avg_age": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident state!=\"Closed\"\n| eval age_hours=(now()-_time)/3600\n| stats avg(age_hours) as value\n| eval value=round(value,1)",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_open_queue": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident\n| search state!=\"Closed\"\n| eval age_hours=round((now()-_time)/3600,1)\n| table _time number priority state assigned_to cmdb_ci business_service age_hours short_description\n| sort priority - _time",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_daily_volume": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident earliest=-7d@d\n| bin _time span=1d\n| stats count as Cases by _time\n| eval Day=strftime(_time, \"%a %m/%d\")\n| sort _time\n| table Day Cases",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_workflow_state": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident\n| eval State=coalesce(state, \"Unknown\")\n| stats count as Cases by State\n| eval sort_order=case(State=\"New\",1, State=\"In Progress\",2, State=\"On Hold\",3, State=\"Resolved\",4, State=\"Closed\",5, true(),99)\n| sort sort_order\n| fields State Cases",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_notable_cases": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident u_splunk_notable_event_id=*\n| table _time number priority state cmdb_ci business_service u_splunk_notable_event_id u_splunk_correlation_search u_mitre_tactic u_mitre_technique\n| sort - _time",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    },
    "ds_high_risk_assets": {
      "type": "ds.search",
      "options": {
        "query": "index=demo_servicenow sourcetype=demo:snow:incident\n| stats count values(priority) as priorities values(state) as states by cmdb_ci business_service\n| sort - count",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        }
      }
    }
  },
  "visualizations": {
    "viz_background": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "# SOC Case Management\nDaily ServiceNow queue for Splunk Enterprise Security demos\n\nMonitor open cases, Splunk ES notable-linked incidents, workflow state, and impacted business services.",
        "fontColor": "#FFFFFF",
        "backgroundColor": "#000000"
      }
    },
    "viz_accent_bar": {
      "type": "splunk.markdown",
      "options": {
        "markdown": " ",
        "backgroundColor": "#86BC25"
      }
    },
    "viz_open_cases": {
      "type": "splunk.singlevalue",
      "dataSources": {
        "primary": "ds_kpi_open_cases"
      },
      "title": "Count",
      "options": {
        "majorColor": "#000000",
        "backgroundColor": "#FFFFFF",
        "trendColor": "#86BC25"
      }
    },
    "viz_notables": {
      "type": "splunk.singlevalue",
      "dataSources": {
        "primary": "ds_kpi_notables"
      },
      "title": "Count",
      "options": {
        "majorColor": "#0076A8",
        "backgroundColor": "#FFFFFF"
      }
    },
    "viz_critical": {
      "type": "splunk.singlevalue",
      "dataSources": {
        "primary": "ds_kpi_critical"
      },
      "title": "Count",
      "options": {
        "majorColor": "#86BC25",
        "backgroundColor": "#FFFFFF"
      }
    },
    "viz_avg_age": {
      "type": "splunk.singlevalue",
      "dataSources": {
        "primary": "ds_kpi_avg_age"
      },
      "title": "Hours",
      "options": {
        "majorColor": "#53565A",
        "backgroundColor": "#FFFFFF",
        "unit": "hrs"
      }
    },
    "viz_open_queue": {
      "type": "splunk.table",
      "dataSources": {
        "primary": "ds_open_queue"
      },
      "title": "Open SOC Queue",
      "options": {
        "headerBackgroundColor": "#000000",
        "headerTextColor": "#FFFFFF",
        "rowBackgroundColor": "#FFFFFF",
        "fontColor": "#53565A"
      }
    },
    "viz_daily_volume": {
      "type": "splunk.column",
      "dataSources": {
        "primary": "ds_daily_volume"
      },
      "title": "Daily Case Trend - Last 7 Days",
      "options": {
        "backgroundColor": "#FFFFFF",
        "seriesColors": [
          "#0076A8"
        ],
        "legendDisplay": "off"
      }
    },
    "viz_workflow_state": {
      "type": "splunk.bar",
      "dataSources": {
        "primary": "ds_workflow_state"
      },
      "title": "Case Queue by Workflow State",
      "options": {
        "backgroundColor": "#FFFFFF",
        "seriesColors": [
          "#00ABAB"
        ],
        "legendDisplay": "off"
      }
    },
    "viz_notable_cases": {
      "type": "splunk.table",
      "dataSources": {
        "primary": "ds_notable_cases"
      },
      "title": "Splunk ES Notable-Linked ServiceNow Cases",
      "options": {
        "headerBackgroundColor": "#0076A8",
        "headerTextColor": "#FFFFFF",
        "rowBackgroundColor": "#FFFFFF",
        "fontColor": "#53565A"
      }
    },
    "viz_high_risk_assets": {
      "type": "splunk.table",
      "dataSources": {
        "primary": "ds_high_risk_assets"
      },
      "title": "Assets and Business Services with Case Activity",
      "options": {
        "headerBackgroundColor": "#00ABAB",
        "headerTextColor": "#FFFFFF",
        "rowBackgroundColor": "#FFFFFF",
        "fontColor": "#53565A"
      }
    },
    "viz_open_cases_label": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "**OPEN CASES**",
        "fontColor": "#FFFFFF",
        "backgroundColor": "#000000"
      }
    },
    "viz_notables_label": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "**ES NOTABLE-LINKED CASES**",
        "fontColor": "#FFFFFF",
        "backgroundColor": "#0076A8"
      }
    },
    "viz_critical_label": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "**HIGH / CRITICAL OPEN**",
        "fontColor": "#FFFFFF",
        "backgroundColor": "#86BC25"
      }
    },
    "viz_avg_age_label": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "**AVG OPEN AGE**",
        "fontColor": "#FFFFFF",
        "backgroundColor": "#53565A"
      }
    }
  },
